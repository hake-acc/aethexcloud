---
import "../styles/globals.css";
import { Footer } from "@/components/layout/Footer";
import { Navbar } from "@/components/layout/Navbar";
import { LenisProvider } from "@/components/animations/LenisProvider";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  additionalStructuredData?: Record<string, unknown>;
}

const {
  title = "Cloud Hosting in India for Websites, Servers & Communities",
  description = "Reliable cloud infrastructure for websites, VPS, Minecraft servers, Discord bots and Lavalink nodes. Built for creators, developers and growing communities.",
  keywords = "cloud hosting India, website hosting India, VPS India, Minecraft server hosting India, Discord bot hosting, Lavalink hosting",
  additionalStructuredData,
} = Astro.props;

const siteTitle = title.includes("AethexCloud") ? title : `${title} | AethexCloud`;
const siteUrl = "https://aethexcloud.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const isHomePage = Astro.url.pathname === "/";
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "AethexCloud",
      url: siteUrl,
      logo: `${siteUrl}/aethex_cloud_logo.png`,
      description,
      areaServed: ["India", "South Asia"],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl,
      name: "AethexCloud",
      description,
      publisher: { "@id": organizationId },
      inLanguage: "en-IN",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: siteTitle,
      description,
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
      inLanguage: "en-IN",
    },
  ],
};
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/aethex_cloud_logo.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site information" />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-700.woff2" as="font" type="font/woff2" crossorigin />
    {isHomePage && (
      <>
        <link
          rel="preload"
          href="/backgrounds/hero-desktop-dark.webp"
          as="image"
          type="image/webp"
          media="(min-width: 768px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          href="/backgrounds/hero-mobile-dark.webp"
          as="image"
          type="image/webp"
          media="(max-width: 767px)"
          fetchpriority="high"
        />
      </>
    )}
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="AethexCloud" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="AethexCloud" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/aethex_cloud_logo.png`} />
    <meta property="og:image:alt" content="AethexCloud" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={`${siteUrl}/aethex_cloud_logo.png`} />
    <meta name="twitter:image:alt" content="AethexCloud logo" />
    <meta name="robots" content="index, follow" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {additionalStructuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(additionalStructuredData)} />}
  </head>
  <body class="min-h-full flex flex-col antialiased">
    <LenisProvider client:idle />
    <Navbar client:idle />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Subtle dynamic surface lighting tracking mouse position
      if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.addEventListener('mousemove', (e) => {
          const cards = document.querySelectorAll('.aethex-surface');
          cards.forEach((card) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            if (x >= -50 && x <= rect.width + 50 && y >= -50 && y <= rect.height + 50) {
              card.style.setProperty('--mx', `${x}px`);
              card.style.setProperty('--my', `${y}px`);
            }
          });
        }, { passive: true });
      }
    </script>
  </body>
</html>